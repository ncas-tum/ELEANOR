{
  "name": "eleanor (cpu)",
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": "..",
    "args": { 
		"UV_EXTRA": "cpu",
		"BASE_IMAGE": "rockylinux:8"
	}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=eleanor-venv-cpu,target=/opt/venv,type=volume",
    "source=uv-cache,target=/root/.cache/uv,type=volume"
  ],
  "postCreateCommand": "dev-sync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-vscode.cmake-tools", "nvidia.nsight-vscode-edition"],
      "settings": { "python.defaultInterpreterPath": "/opt/venv/bin/python" }
    }
  }
}