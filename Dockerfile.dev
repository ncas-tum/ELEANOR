# syntax=docker/dockerfile:1
ARG BASE_IMAGE=nvidia/cuda:12.6.3-devel-rockylinux8
FROM ${BASE_IMAGE}

RUN dnf install -y gcc-toolset-12 git && dnf clean all
ENV PATH="/opt/rh/gcc-toolset-12/root/usr/bin:${PATH}" \
    CC=gcc \
    CXX=g++ \
    CUDAHOSTCXX=g++

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /uvx /bin/

# The source is bind-mounted at runtime and owned by your host user;
# without this, git (and therefore setuptools-scm) refuses to read it
RUN git config --global --add safe.directory /workspace

WORKDIR /workspace

ARG PYTHON_VERSION=3.14
ARG UV_EXTRA=cuda12

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=${PYTHON_VERSION} \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    ELEANOR_EXTRA=${UV_EXTRA} \
    PATH="/opt/venv/bin:${PATH}"

# Pre-install all dependencies (including the dev group) and the build tools,
# so starting the container doesn't download several GB every time
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=README.md,target=README.md \
    --mount=type=bind,source=LICENSE.txt,target=LICENSE.txt \
    mkdir -p eleanor && \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ELEANOR=0.0.0 \
    uv sync --frozen --extra ${UV_EXTRA} --no-install-project && \
    uv pip install scikit-build-core setuptools-scm cmake ninja && \
    rm -rf eleanor

# Helper: editable install of eleanor, built against the venv's torch
RUN printf '#!/bin/sh\nexec uv sync --inexact --extra "$ELEANOR_EXTRA" --no-build-isolation-package eleanor "$@"\n' \
      > /usr/local/bin/dev-sync && chmod +x /usr/local/bin/dev-sync

CMD ["bash"]